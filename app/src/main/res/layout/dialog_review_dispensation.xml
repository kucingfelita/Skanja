<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="?attr/colorSurface">

    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Konfirmasi Dispensasi"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tv_dialog_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Siswa: Ahmad\nNIS: 2314098\n\nAlasan:\n&quot;Keluarga ada acara&quot;"
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurface"
        android:alpha="0.8"
        android:layout_marginBottom="24dp"/>

    <!-- Tombol Lihat PDF berkas -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_view_pdf"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="LIHAT SURAT PDF 📄"
        android:textStyle="bold"
        app:cornerRadius="12dp"
        android:layout_marginBottom="16dp"/>

    <!-- Aksi Setuju / Tolak -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reject"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="TOLAK"
            android:textColor="#EF4444"
            app:strokeColor="#EF4444"
            app:cornerRadius="12dp"
            android:layout_marginEnd="6dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_approve"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="SETUJU"
            android:backgroundTint="#10B981"
            app:cornerRadius="12dp"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
</LinearLayout>
